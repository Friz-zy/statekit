FROM docker.io/library/golang:1.26.6@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6

ENV GOTOOLCHAIN=local \
    HOME=/tmp/home \
    GOPATH=/tmp/go \
    GOMODCACHE=/tmp/go-mod-cache \
    GOCACHE=/tmp/go-cache

WORKDIR /workspace
RUN mkdir -p /tmp/home /tmp/go /tmp/go-mod-cache /tmp/go-cache && \
    chown -R 65532:65532 /tmp/home /tmp/go /tmp/go-mod-cache /tmp/go-cache
COPY go.mod go.sum ./
USER 65532:65532

# Dependency resolution is deliberately the only network-enabled build phase.
RUN go mod download

ARG GO_DEPS_IMAGE=statekit-e51-go-deps:ci
FROM ${GO_DEPS_IMAGE} AS build

WORKDIR /workspace
COPY --chown=65532:65532 . .
USER 65532:65532
ENV GOENV=off GOTOOLCHAIN=local GOWORK=off GOPROXY=off GOSUMDB=sum.golang.org \
    GOPRIVATE="" GONOPROXY="" GONOSUMDB=""

# The rootless OCI build is network-denied; only the separate fixed fetch stage
# can access Go modules. Build as the non-root user and write the artifact in /tmp.
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=live-e5.1" \
    -o /tmp/statekit ./cmd/statekit

FROM ${GO_DEPS_IMAGE}
COPY --from=build --chown=65532:65532 /tmp/statekit /out/statekit
